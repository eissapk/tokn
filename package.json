{
  "name": "buildr",
  "description": "Olum App",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run css && concurrently -k -n css,app -c magenta,green \"npm run css:watch\" \"npm run dev:app\"",
    "build": "rm -rf ./docs && olum-compiler build && mv ./dist ./docs && echo tokn.eissa.top > ./docs/CNAME && node scripts/build-sw.js",
    "start": "olum-compiler start",
    "css": "tailwindcss -i src/main.css -o public/main.css",
    "css:watch": "npm run css -- --watch",
    "dev:app": "olum-compiler dev"
  },
  "olum": {
    "SITE_URL": "https://tokn.eissa.top",
    "SSG_DELAY": 0,
    "base": "/"
  },
  "keywords": [
    "olum"
  ],
  "author": "Eissa Saber",
  "license": "ISC",
  "dependencies": {
    "olum": "^0.13.0",
    "olum-icons": "^0.4.0",
    "olum-router": "^0.6.1",
    "olum-store": "^0.1.0",
    "olum-transition": "^0.2.1",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.5",
    "olum-compiler": "^2.1.3",
    "olum-devtool": "^1.0.5",
    "puppeteer": "^25.17.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "main": "dist/index.html",
  "window": {
    "title": "Note Manager",
    "toolbar": true,
    "frame": true,
    "width": 1073,
    "height": 660,
    "min_width": 500,
    "min_height": 500,
    "icon": "dist/favicon.svg",
    "position": "center",
    "background-color": "#a69aa6"
  },
  "chromium-args": "--disable-web-security",
  "webview": {
    "partitions": [
      {
        "name": "trusted",
        "accessible_resources": [
          "file://*/*"
        ]
      }
    ]
  }
}
